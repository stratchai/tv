# stratchai-tv — set these in Vercel → Project → Settings → Environment Variables
# (NOT in this repo — the token is a secret; the repo is public).

# The dashboard kiosk token (dashboard/.env.local → KIOSK_TOKEN). Anyone with it
# gets READ access to the live book, so keep it in the Vercel env only.
KIOSK_TOKEN=

# The dashboard's Tailscale-Funnel kiosk endpoint. Override if the host changes.
# Default: https://bradys-mac-mini.tail3bccb5.ts.net/api/kiosk
KIOSK_FUNNEL_URL=
